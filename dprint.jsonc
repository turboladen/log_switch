{
  "markdown": {
    "lineWidth": 100
  },
  "yaml": {
    // markdown calls this lineWidth; this plugin calls it printWidth
    "printWidth": 100
  },
  "includes": ["**/*.{md,yml,yaml}"],
  // dprint honours .gitignore, so coverage/ and vendor/bundle need no entry here.
  // What is left is the set of files it would otherwise pick up and should not own.
  "excludes": [
    // Generated by `rubocop --auto-gen-config`, which rewrites it wholesale --
    // formatting would be undone on the next regeneration.
    ".rubocop_todo.yml",
    // Tracker-owned: bd writes these.
    ".beads/**",
    // Vendored skill definitions.
    ".agents/**"
  ],
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.22.1.wasm",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm"
  ]
}
